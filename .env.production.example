# Docker image used by docker compose
DOCKER_IMAGE=yourdockerhub/orion-chat-backend:latest

# App runtime
NODE_ENV=production
PORT=3000
TYPEORM_SYNC=false
JWT_SECRET=replace-me
JWT_EXPIRES_IN=30d
APP_BASE_URL=https://api.your-domain.com
WEB_BASE_URL=https://your-frontend-domain.com
# Use * only for testing. Production should list exact frontend origins.
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:5173
SOCKET_ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:5173

# PostgreSQL (container service name = postgres)
DB_HOST=postgres
DB_PORT=5432
DB_USER=orion_user
DB_PASSWORD=replace-me
DB_NAME=orion_chat

# MongoDB (container service name = mongodb)
MONGO_URI=mongodb://root:replace-me@mongodb:27017/orion_chat?authSource=admin
# Optional legacy fallback key that code still supports
# MONGO_URL=mongodb://root:replace-me@mongodb:27017/orion_chat?authSource=admin
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=replace-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# OnlyOffice document server (container is exposed locally on EC2 port 8088)
ONLYOFFICE_DOCUMENT_SERVER_URL=https://api.your-domain.com/onlyoffice
ONLYOFFICE_CALLBACK_BASE_URL=https://api.your-domain.com
# Optional. If empty, backend uses JWT_SECRET for callback signing.
ONLYOFFICE_CALLBACK_SECRET=
ONLYOFFICE_JWT_ENABLED=false
ONLYOFFICE_JWT_SECRET=

# Optional Stream video provider. Required only for POST /stream-video/token.
STREAM_API_KEY=
STREAM_SECRET_KEY=

# AWS S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET=replace-me
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_FORCE_PATH_STYLE=false

# OTP provider
ESMS_API_KEY=replace-me
ESMS_SECRET_KEY=replace-me

# AI provider
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-me
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-flash-latest
