# Docker image used by docker compose
DOCKER_IMAGE=yourdockerhub/orion-chat-backend:latest

# App runtime
NODE_ENV=production
PORT=3000
TYPEORM_SYNC=false
JWT_SECRET=replace-me
JWT_EXPIRES_IN=30d
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-other-frontend.com
SOCKET_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-other-frontend.com

# PostgreSQL (container service name = postgres)
DB_HOST=postgres
DB_PORT=5432
DB_USER=orion_user
DB_PASSWORD=replace-me
DB_NAME=orion_chat

# MongoDB
# Option 1: direct URI
MONGO_URI=mongodb://root:replace-me@mongodb:27017/orion_chat?authSource=admin
# Option 2: legacy key supported by code
# MONGO_URL=mongodb://root:replace-me@mongodb:27017/orion_chat?authSource=admin
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=replace-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# AWS S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET=replace-me
AWS_S3_PUBLIC_BASE_URL=

# OTP provider
ESMS_API_KEY=replace-me
ESMS_SECRET_KEY=replace-me
