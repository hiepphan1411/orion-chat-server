# Docker image used by docker compose
DOCKER_IMAGE=phuochiepphan/orion-chat-backend:latest

# App runtime
NODE_ENV=production
PORT=3000
TYPEORM_SYNC=false
JWT_SECRET=replace-me
JWT_EXPIRES_IN=30d
# Optional app URL if you need it in future features
# APP_URL=https://api.your-domain.com
ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-other-frontend.com
SOCKET_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://your-other-frontend.com

# PostgreSQL (container service name = postgres)
DB_HOST=postgres
DB_PORT=5432
DB_USER=orion_user
DB_PASSWORD=orion2026
DB_NAME=orion_chat

# MongoDB (container service name = mongodb)
MONGO_URI=mongodb+srv://mongobasic:mongo123@cluster0.pro5bts.mongodb.net/orion_chat?retryWrites=true&w=majority&appName=Cluster0
# Optional legacy fallback key that code still supports
# MONGO_URL=mongodb://root:replace-me@mongodb:27017/orion_chat?authSource=admin
MONGO_INITDB_ROOT_USERNAME=mongobasic
MONGO_INITDB_ROOT_PASSWORD=mongo123

# Redis
